[Unit]
Description=FeynosRGB lighting (headless)
Documentation=https://github.com/Feynos-Lin/FeynosRGB
After=pipewire.service pipewire-pulse.service
Wants=pipewire-pulse.service

[Service]
Type=simple
ExecStart=/usr/bin/feynosrgb daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
